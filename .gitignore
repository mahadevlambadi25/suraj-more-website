# ── Personal data & local databases: never commit ───────
.data
backups
.pgdata
*.dump
*.sql.gz
*.sqlite
*.db

# ── Logs & OS/editor clutter ────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
