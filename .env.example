# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, set these in Project → Settings → Environment Variables (Production / Preview separately).

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL, e.g. Neon) ────────────────────
# DATABASE_URL: POOLED connection used by the app (Neon host with "-pooler", add ?sslmode=require&pgbouncer=true&connection_limit=1)
# DIRECT_URL:   DIRECT (non-pooled) connection used only by `prisma migrate`
# Note: Prisma CLI reads `.env` (not `.env.local`) — put local DB URLs in `.env`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/suraj_dev
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/suraj_dev

# ── Cashfree ────────────────────────────────────────────
# mock       = local simulated checkout (dev only; refused in production)
# sandbox    = Cashfree TEST environment (use sandbox App ID / Secret)
# production = LIVE payments — locked unless CASHFREE_ALLOW_PRODUCTION=true (launch sign-off only)
CASHFREE_MODE=mock
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Optional. Cashfree signs webhooks with the secret key; set this only if Cashfree gives you a separate webhook secret.
CASHFREE_WEBHOOK_SECRET=
# Re-check every successful payment with Cashfree's API before marking paid (recommended: leave unset = on)
CASHFREE_VERIFY_WITH_API=
CASHFREE_ALLOW_PRODUCTION=

# ── Messaging / CRM (JSON webhooks: Make, Zapier, n8n or provider endpoint) ──
# Unset = messages are recorded as NOT_CONFIGURED (never reported as sent).
EMAIL_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
# Fallback for both email and WhatsApp if the specific ones are unset:
NOTIFY_WEBHOOK_URL=
CRM_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_URL=
# Optional HMAC (X-Signature header) so your automation can verify requests came from this site
INTEGRATION_SIGNING_SECRET=

# Booking link emailed ONLY after a mentorship application is accepted (can also be set in /ops → Settings)
MENTORSHIP_BOOKING_URL=

# ── Security ────────────────────────────────────────────
# Random string used to hash IPs for rate limiting/audit (e.g. `openssl rand -hex 32`)
HASH_SALT=

# ── Analytics (loaded only after cookie consent; never on /ops) ──
NEXT_PUBLIC_GTM_ID=

# ── Tooling / development switches (NOT for production — leave unset on Vercel) ──
# ALLOW_MOCK_PAYMENTS=true   lets CASHFREE_MODE=mock run in a production *build* (local QA only).
#                            NEVER set on a deployed site: mock mode enables the simulated-payment route.
#                            Vercel builds refuse CASHFREE_MODE=mock regardless (scripts/check-env.mjs).
# ALLOW_SAMPLE_CONTENT=true  shows cohorts flagged isSample in a production build (local QA only).
# SEED_SAMPLE_DATA=true|false  force/skip the sample cohort in `npm run db:seed` (default: only outside production).
# TEST_DATABASE_URL=         Postgres for `npm test` (database name must contain "test"; it is truncated per test).
# NEXT_DIST_DIR=             alternative build folder for a local production build next to a running dev server.
#
# Provided by the platform — do not set manually: NODE_ENV, VERCEL, VERCEL_ENV.
#
# One-off command inputs — pass inline, NEVER store in an env file:
#   ADMIN_EMAIL, ADMIN_NAME, ADMIN_ROLE, ADMIN_PASSWORD   → npm run admin:create
#   BASE_URL, SESSION_COOKIE                              → npm run smoke
