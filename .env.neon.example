# Template for .env.neon — copy to .env.neon and fill in from Neon → Connect. Never commit .env.neon.
# Used only by `npm run neon -- …` (scripts/neon.mjs); never loaded automatically by Next.js or Prisma.
#
# Pooled (host contains "-pooler") + pgbouncer=true&connection_limit=1 — what the deployed app uses:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connection_limit=1"
# Direct (no "-pooler") — used by prisma migrate:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
